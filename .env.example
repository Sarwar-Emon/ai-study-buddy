# Copy to .env and fill in. Never commit the real .env file.

# Protects the API. Use any long random value (about 30 characters).
API_KEY=change-me-to-a-long-random-value

# ---------------------------------------------------------------
# OPTION A (default): Google Gemini - free, no credit card
# Get a key at https://aistudio.google.com/apikey
# Free tier: Google may use your uploaded text to improve its products,
# so do not upload private or sensitive documents.
# ---------------------------------------------------------------
OPENAI_API_KEY=paste-your-gemini-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# ---------------------------------------------------------------
# OPTION B: OpenAI (paid). To use it, delete the four lines in
# option A and remove the # from these four lines.
# Key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning
# MIN_SCORE=0.2
# TOP_K=4

# Trust check: one extra model call per answer. Set to false to save free-tier quota.
# VERIFY_ANSWERS=true

# Slow answers or quizzes? Models that "think" first can be sped up. Not every model accepts it.
# REASONING_EFFORT=low
