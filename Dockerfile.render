# Single container for a public demo: builds the React app, then serves it from FastAPI.
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/data \
    STATIC_DIR=/srv/web \
    SAMPLE_PDF=/srv/samples/study_sample.pdf \
    DEMO_MODE=true
WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY samples/study_sample.pdf ./samples/study_sample.pdf
COPY --from=web /web/dist ./web
RUN useradd --create-home appuser && mkdir /data && chown appuser /data
USER appuser
# Render sets PORT. Fall back to 8000 for local runs.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
